# Server
PORT=5000
NODE_ENV=development

# Database
# Docker (recommended): docker compose up -d  →  port 5433
DATABASE_URL="postgresql://postgres:flyxo123@localhost:5433/flyxo_db?schema=public"
# OR local PostgreSQL on 5432:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/flyxo_db?schema=public"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=FLYXO <noreply@flyxo.com>

# Google Maps (frontend uses this; optional backend)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
